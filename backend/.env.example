# Copy this file to backend/.env and fill in real values.

# S3 trend data source for live dashboard graphing
AWS_S3_TRENDS_BUCKET=centralized-security-findings
AWS_S3_TRENDS_KEY=all-ac-security-scores/May_benchmark_scores.csv

# Account report XLSX files (one file per account, merged when multiple accounts are selected)
AWS_S3_REPORT_BUCKET=centralized-security-findings
AWS_S3_ACCOUNT_REPORT_KEY_TEMPLATE=account_reports/{account_id}.xlsx

# Azure email configuration for Microsoft Graph
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
